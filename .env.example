# Copy to .env and fill in ONE of these (all have free tiers).
LLM_PROVIDER=groq
GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# Jev (TypeSafe decision model) for choice questions - key: https://console.typesafe.ai/keys
# LLM_PROVIDER=jev
# TYPESAFE_API_KEY=
# TEXT_PROVIDER=groq        # writes free-text answers when LLM_PROVIDER=jev

# Optional overrides
# LLM_MODEL=openai/gpt-oss-120b
# LLM_BASE_URL=https://any-openai-compatible-endpoint/v1
